{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docuworks-studio",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
